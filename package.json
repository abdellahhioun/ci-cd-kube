{
  "name": "ci-cd-kube",
  "version": "1.0.0",
  "description": "CI/CD automated pipeline with GitHub Actions, Hono app, and Kubernetes deployment placeholders",
  "main": "src/index.ts",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "cypress run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.12.2",
    "hono": "^4.5.11"
  },
  "devDependencies": {
    "@types/node": "^20.14.9",
    "@vitest/coverage-v8": "^4.1.11",
    "cypress": "^13.13.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.2",
    "vitest": "^4.1.11"
  }
}
